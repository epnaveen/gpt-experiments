<mxfile host="app.diagrams.net" modified="2025-08-08T00:12:00.000Z" agent="AI-GPT-5" version="22.0.8" type="device">
  <diagram id="aws-physical-deployment" name="AWS Physical Deployment Model (Neat)">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- AWS Cloud (Account) -->
        <mxCell id="aws_cloud" value="AWS Cloud (Account)" style="shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.aws_cloud;labelPosition=left;verticalLabelPosition=top;align=center;verticalAlign=top;fontSize=16;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="2240" height="1320" as="geometry"/>
        </mxCell>

        <!-- Top Row: Internet -> Route53 -> CloudFront -> WAF -->
        <mxCell id="internet" value="Internet" style="shape=mxgraph.aws4.internet_alt1;html=1;" vertex="1" parent="aws_cloud">
          <mxGeometry x="60" y="30" width="110" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="route53" value="Amazon Route 53" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.route_53;" vertex="1" parent="aws_cloud">
          <mxGeometry x="210" y="30" width="150" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="cloudfront" value="Amazon CloudFront" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudfront;" vertex="1" parent="aws_cloud">
          <mxGeometry x="390" y="30" width="170" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="waf" value="AWS WAF (Web ACL)" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.waf;" vertex="1" parent="aws_cloud">
          <mxGeometry x="590" y="30" width="160" height="80" as="geometry"/>
