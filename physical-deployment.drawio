          <mxGeometry x="60" y="140" width="2120" height="1120" as="geometry"/>
        </mxCell>

        <!-- Internet Gateway -->
        <mxCell id="igw" value="Internet Gateway" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.internet_gateway;" vertex="1" parent="vpc">
          <mxGeometry x="1920" y="20" width="180" height="80" as="geometry"/>
        </mxCell>

        <!-- Availability Zones neatly side-by-side -->
        <mxCell id="az_a" value="Availability Zone A" style="shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.availability_zone;labelPosition=left;verticalLabelPosition=top;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="vpc">
          <mxGeometry x="80" y="100" width="1020" height="960" as="geometry"/>
        </mxCell>
        <mxCell id="az_b" value="Availability Zone B" style="shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.availability_zone;labelPosition=left;verticalLabelPosition=top;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="vpc">
          <mxGeometry x="1140" y="100" width="1020" height="960" as="geometry"/>
        </mxCell>

        <!-- Public Subnets row -->
        <mxCell id="pub_a" value="Public Subnet A\n10.0.1.0/24" style="shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.public_subnet;" vertex="1" parent="az_a">
          <mxGeometry x="40" y="60" width="940" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="pub_b" value="Public Subnet B\n10.0.2.0/24" style="shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.public_subnet;" vertex="1" parent="az_b">
          <mxGeometry x="40" y="60" width="940" height="220" as="geometry"/>
        </mxCell>

        <!-- Place ALB centered above app tier for clean vertical drops -->
        <mxCell id="alb" value="Application Load Balancer (HTTPS)" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.application_load_balancer;" vertex="1" parent="vpc">
          <mxGeometry x="1010" y="160" width="220" height="120" as="geometry"/>
        </mxCell>

        <!-- Network Firewall left; NAT right in each public subnet -->
        <mxCell id="netfw_a" value="Network Firewall" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.network_firewall;" vertex="1" parent="pub_a">
          <mxGeometry x="60" y="120" width="200" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="nat_a" value="NAT Gateway" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.nat_gateway;" vertex="1" parent="pub_a">
          <mxGeometry x="760" y="120" width="140" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="netfw_b" value="Network Firewall" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.network_firewall;" vertex="1" parent="pub_b">
          <mxGeometry x="60" y="120" width="200" height="80" as="geometry"/>
