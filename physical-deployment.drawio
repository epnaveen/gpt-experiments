        <mxCell id="ec2_b2" value="EC2 (App)" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ec2;" vertex="1" parent="app_b">
          <mxGeometry x="540" y="150" width="130" height="80" as="geometry"/>
        </mxCell>

        <!-- VPC Interface Endpoints inside App subnets for short dashed lines -->
        <mxCell id="vpce_secrets_a" value="Interface VPC Endpoint\n(Secrets Manager)" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.interface_vpc_endpoint;" vertex="1" parent="app_a">
          <mxGeometry x="720" y="170" width="200" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="vpce_secrets_b" value="Interface VPC Endpoint\n(Secrets Manager)" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.interface_vpc_endpoint;" vertex="1" parent="app_b">
          <mxGeometry x="720" y="170" width="200" height="90" as="geometry"/>
        </mxCell>

        <!-- DB Subnets row -->
        <mxCell id="db_a" value="Private DB Subnet A\n10.0.21.0/24" style="shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.private_subnet;" vertex="1" parent="az_a">
          <mxGeometry x="40" y="640" width="940" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="db_b" value="Private DB Subnet B\n10.0.22.0/24" style="shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.private_subnet;" vertex="1" parent="az_b">
          <mxGeometry x="40" y="640" width="940" height="300" as="geometry"/>
        </mxCell>

        <mxCell id="rds_primary" value="Amazon RDS (Primary)\nPostgreSQL" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.rds_instance;" vertex="1" parent="db_a">
          <mxGeometry x="360" y="100" width="180" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="rds_standby" value="Amazon RDS (Standby)" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.rds_instance;" vertex="1" parent="db_b">
          <mxGeometry x="360" y="100" width="180" height="100" as="geometry"/>
        </mxCell>

        <!-- Security Groups (legend style, no connecting lines to avoid clutter) -->
        <mxCell id="sg_alb" value="SG-ALB: allow 443 from Internet\nTargets: SG-App (443)" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.security_group;opacity=90;" vertex="1" parent="vpc">
          <mxGeometry x="1260" y="160" width="210" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="sg_app" value="SG-App: allow 443 from SG-ALB\negress 443/80" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.security_group;opacity=90;" vertex="1" parent="vpc">
          <mxGeometry x="820" y="500" width="220" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="sg_db" value="SG-DB: allow 5432 from SG-App" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.security_group;opacity=90;" vertex="1" parent="vpc">
          <mxGeometry x="1560" y="880" width="210" height="90" as="geometry"/>
        </mxCell>

        <!-- Regional services (right), minimal edges to avoid crossings) -->
        <mxCell id="secrets_mgr" value="AWS Secrets Manager" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.secrets_manager;" vertex="1" parent="aws_cloud">
          <mxGeometry x="1960" y="520" width="200" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="cloudwatch" value="Amazon CloudWatch" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch;" vertex="1" parent="aws_cloud">
          <mxGeometry x="1780" y="30" width="170" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="cloudtrail" value="AWS CloudTrail" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudtrail;" vertex="1" parent="aws_cloud">
          <mxGeometry x="1960" y="30" width="170" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="config" value="AWS Config" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.config;" vertex="1" parent="aws_cloud">
          <mxGeometry x="2140" y="30" width="150" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="iam" value="IAM" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.iam;" vertex="1" parent="aws_cloud">
          <mxGeometry x="1620" y="30" width="140" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="kms" value="AWS KMS" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.kms;" vertex="1" parent="aws_cloud">
          <mxGeometry x="1460" y="30" width="140" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="ssm" value="AWS Systems Manager\n(Session Manager)" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.systems_manager;" vertex="1" parent="aws_cloud">
          <mxGeometry x="1300" y="30" width="150" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="admin" value="Administrator" style="shape=umlActor;whiteSpace=wrap;html=1;" vertex="1" parent="aws_cloud">
          <mxGeometry x="1200" y="30" width="60" height="120" as="geometry"/>
        </mxCell>

        <!-- Route Tables (legend, no connecting edges) -->
        <mxCell id="rt_public" value="Public RT: 0.0.0.0/0 → IGW" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.route_table;opacity=90;" vertex="1" parent="vpc">
          <mxGeometry x="1900" y="220" width="200" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="rt_app" value="App RT: 0.0.0.0/0 → NAT" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.route_table;opacity=90;" vertex="1" parent="vpc">
          <mxGeometry x="1900" y="360" width="200" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="rt_db" value="DB RT: no Internet route" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.route_table;opacity=90;" vertex="1" parent="vpc">
          <mxGeometry x="1900" y="500" width="200" height="90" as="geometry"/>
        </mxCell>

        <!-- Flows with orthogonal connectors and minimal crossing -->
        <mxCell id="e_internet_r53" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;endArrow=block;strokeWidth=2;rounded=0;" edge="1" parent="aws_cloud" source="internet" target="route53">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_r53_cf" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;endArrow=block;strokeWidth=2;rounded=0;" edge="1" parent="aws_cloud" source="route53" target="cloudfront">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_cf_waf" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;endArrow=block;strokeWidth=2;rounded=0;" edge="1" parent="aws_cloud" source="cloudfront" target="waf">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_waf_alb" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;endArrow=block;strokeWidth=2;rounded=0;" edge="1" parent="aws_cloud" source="waf" target="alb">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="690" y="140"/>
              <mxPoint x="1120" y="140"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ALB straight down to one EC2 per AZ to reduce clutter -->
        <mxCell id="e_alb_ec2_a" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;endArrow=block;strokeWidth=2;rounded=0;" edge="1" parent="vpc" source="alb" target="ec2_a1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_alb_ec2_b" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;endArrow=block;strokeWidth=2;rounded=0;" edge="1" parent="vpc" source="alb" target="ec2_b1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- EC2 to RDS primary (two neat orthogonal paths) -->
        <mxCell id="e_ec2a_rds" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeWidth=2;rounded=0;" edge="1" parent="vpc" source="ec2_a1" target="rds_primary">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_ec2b_rds" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeWidth=2;rounded=0;" edge="1" parent="vpc" source="ec2_b1" target="rds_primary">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1520" y="760"/>
              <mxPoint x="560" y="760"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- EC2 to VPC Endpoints (short dashed within subnets) -->
        <mxCell id="e_ec2a_vpce" style="edgeStyle=orthogonalEdgeStyle;dashed=1;dashPattern=5 5;endArrow=block;strokeWidth=2;strokeColor=#ef5350;rounded=0;" edge="1" parent="vpc" source="ec2_a1" target="vpce_secrets_a">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_ec2b_vpce" style="edgeStyle=orthogonalEdgeStyle;dashed=1;dashPattern=5 5;endArrow=block;strokeWidth=2;strokeColor=#ef5350;rounded=0;" edge="1" parent="vpc" source="ec2_b1" target="vpce_secrets_b">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- VPC Endpoints to Secrets Manager (to the right, no crossing) -->
        <mxCell id="e_vpcea_sm" style="edgeStyle=orthogonalEdgeStyle;dashed=1;dashPattern=5 5;endArrow=block;strokeWidth=2;strokeColor=#ef5350;rounded=0;" edge="1" parent="aws_cloud" source="vpce_secrets_a" target="secrets_mgr">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_vpceb_sm" style="edgeStyle=orthogonalEdgeStyle;dashed=1;dashPattern=5 5;endArrow=block;strokeWidth=2;strokeColor=#ef5350;rounded=0;" edge="1" parent="aws_cloud" source="vpce_secrets_b" target="secrets_mgr">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Admin to SSM only (no crossing), avoid direct lines to EC2 for cleanliness -->
        <mxCell id="e_admin_ssm" style="edgeStyle=orthogonalEdgeStyle;dashed=1;dashPattern=4 4;endArrow=block;strokeWidth=2;rounded=0;" edge="1" parent="aws_cloud" source="admin" target="ssm">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Minimal legends -->
        <mxCell id="legend1" value="TLS 443 from Internet → CF → WAF → ALB.\nALB → EC2 (443). EC2 → RDS (5432). Secrets fetched via Interface VPC Endpoints." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="aws_cloud">
          <mxGeometry x="60" y="1280" width="1100" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="legend2" value="Encryption: KMS CMK for RDS & Secrets; TLS in-transit. Logging/metrics: CloudWatch, CloudTrail, Config." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="aws_cloud">
          <mxGeometry x="1200" y="1280" width="900" height="60" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
