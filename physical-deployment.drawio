          <mxGeometry x="40" y="320" width="940" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="app_b" value="Private App Subnet B\n10.0.12.0/24" style="shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.private_subnet;" vertex="1" parent="az_b">
          <mxGeometry x="40" y="320" width="940" height="300" as="geometry"/>
        </mxCell>

        <!-- EC2 instances aligned below ALB for straight lines -->
        <mxCell id="ec2_a1" value="EC2 (App)" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ec2;" vertex="1" parent="app_a">
          <mxGeometry x="260" y="70" width="130" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="ec2_a2" value="EC2 (App)" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ec2;" vertex="1" parent="app_a">
          <mxGeometry x="430" y="150" width="130" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="ec2_b1" value="EC2 (App)" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ec2;" vertex="1" parent="app_b">
          <mxGeometry x="380" y="70" width="130" height="80" as="geometry"/>
